# MQTT Broker Configuration
# HiveMQ public broker is reliable and requires zero setup for testing
MQTT_BROKER=broker.hivemq.com
MQTT_PORT=1883
MQTT_CLIENT_PREFIX=smarthome_user
MQTT_KEEPALIVE=60

# Topic Configurations (Matches Contract)
TOPIC_SENSORS=home/room1/sensors
TOPIC_CMD=home/room1/cmd
TOPIC_ALERTS=home/alerts

# Database Path
DB_PATH=smart_home.db

# Default Hardware & Tariff Config
DEFAULT_LIGHT_WATTS=15.0
DEFAULT_FAN_WATTS=75.0
DEFAULT_TARIFF_PER_KWH=0.15
DEFAULT_LUX_THRESHOLD=200.0
DEFAULT_TIMEOUT_SEC=30
